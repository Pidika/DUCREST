# Copy this file to .env for local development. In production, add the same
# values to the Namecheap Node.js application's environment configuration.

NEXT_PUBLIC_SITE_URL=https://ducrestpartners.com

# Sanity News & Insights CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Supabase enquiry database — never expose the service-role key to the browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend transactional email
RESEND_API_KEY=
ENQUIRY_NOTIFICATION_EMAIL=info@ducrestpartners.com
RESEND_FROM_EMAIL=enquiries@ducrestpartners.com

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
